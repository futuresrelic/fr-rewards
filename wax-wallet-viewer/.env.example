# ============================================
# WAX WALLET VIEWER - Environment Variables
# ============================================
# Copy this to .env.local for local development
# Set these as Railway environment variables in production

# ---- ADMIN PANEL ----
# Strong secret password for admin access (change this!)
ADMIN_PASSWORD=change_me_to_something_strong

# JWT secret for admin session tokens (generate a random 32+ char string)
JWT_SECRET=generate_a_random_secret_here_minimum_32_characters

# ---- WAX BLOCKCHAIN ----
# Mainnet RPC endpoints (comma-separated for fallback)
WAX_RPC_ENDPOINTS=https://wax.greymass.com,https://wax.eosusa.io,https://api.waxsweden.org

# ---- ATOMICASSETS API ----
# Primary AtomicAssets API endpoint
ATOMICASSETS_API=https://wax.api.atomicassets.io

# ---- IPFS GATEWAYS ----
# Comma-separated list (first working one is used)
IPFS_GATEWAYS=https://atomichub-ipfs.com/ipfs,https://cloudflare-ipfs.com/ipfs,https://ipfs.io/ipfs,https://gateway.pinata.cloud/ipfs

# ---- NEXT.JS ----
# Public URL of your app (used for WAX Cloud Wallet callback)
# For Railway: https://your-app.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WAX Network
NEXT_PUBLIC_WAX_CHAIN_ID=1064487b3cd1a897ce03ae5b6a865651747e2e152090f99c1d19d44e01aea5a4
NEXT_PUBLIC_WAX_RPC=https://wax.greymass.com

# AtomicAssets API (public - exposed to browser)
NEXT_PUBLIC_ATOMICASSETS_API=https://wax.api.atomicassets.io

# IPFS Gateway (primary, public)
NEXT_PUBLIC_IPFS_GATEWAY=https://atomichub-ipfs.com/ipfs

# App name shown in wallet connection dialogs
NEXT_PUBLIC_APP_NAME=WAX Wallet Viewer
