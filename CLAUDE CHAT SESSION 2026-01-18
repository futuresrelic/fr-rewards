🛡️ Safety Checks (Backend)
async function executeCraft(recipe_id, batch_count, transfer_tx_id, asset_ids, user_wallet) {
  // 1. Verify recipe exists and is enabled
  const recipe = getRecipe(recipe_id);
  if (!recipe || !recipe.enabled) throw new Error('Recipe not available');
  
  // 2. Verify batch count is valid
  if (batch_count > recipe.max_batch_multiplier) throw new Error('Batch too large');
  
  // 3. Check cooldown
  const lastCraft = getLastCraft(user_wallet, recipe_id);
  if (recipe.cooldown_enabled && lastCraft) {
    const hoursSince = (Date.now() - lastCraft.crafted_at) / 3600000;
    if (hoursSince < recipe.cooldown_hours) {
      throw new Error(`Cooldown active. ${recipe.cooldown_hours - hoursSince}h remaining`);
    }
  }
  
  // 4. Verify transaction exists on blockchain
  const tx = await verifyTransactionOnChain(transfer_tx_id);
  if (!tx) throw new Error('Transfer transaction not found');
  
  // 5. Verify ALL assets were transferred to futuresrelic
  const transfers = extractTransfers(tx);
  const expectedAssetCount = recipe.ingredients.reduce((sum, ing) => sum + ing.amount, 0) * batch_count;
  
  if (transfers.length !== expectedAssetCount) {
    throw new Error(`Expected ${expectedAssetCount} transfers, got ${transfers.length}`);
  }
  
  // 6. Verify recipient is futuresrelic
  for (const transfer of transfers) {
    if (transfer.to !== 'futuresrelic') {
      throw new Error('Assets not transferred to futuresrelic');
    }
  }
  
  // 7. Verify asset template IDs match recipe
  for (const ingredient of recipe.ingredients) {
    const neededCount = ingredient.amount * batch_count;
    const transferredCount = transfers.filter(t => 
      t.template_id === ingredient.template_id
    ).length;
    
    if (transferredCount !== neededCount) {
      throw new Error(`Wrong ingredient count for template ${ingredient.template_id}`);
    }
  }
  
  // 8. Check for duplicate transaction (prevent double-mint)
  const existing = getCraftByTransactionId(transfer_tx_id);
  if (existing) {
    if (existing.status === 'completed') {
      return { success: true, already_processed: true, ...existing };
    }
  }
  
  // 9. Record craft attempt
  const craftRecord = saveCraftHistory({
    recipe_id,
    user_wallet,
    batch_count,
    transfer_transaction_id: transfer_tx_id,
    ingredient_asset_ids: asset_ids,
    status: 'pending_mint'
  });
  
  // 10. Mint results
  try {
    const mintResults = [];
    for (const result of recipe.results) {
      const mintCount = result.amount * batch_count;
      for (let i = 0; i < mintCount; i++) {
        const mintTx = await mintNFT(user_wallet, 'futuresrelic', result.template_id);
        mintResults.push(mintTx);
      }
    }
    
    // 11. Update craft record
    updateCraftHistory(craftRecord.id, {
      mint_transaction_id: mintResults[0].transaction_id,
      status: 'completed',
      result_info: recipe.results
    });
    
    return {
      success: true,
      mint_transaction_id: mintResults[0].transaction_id,
      results: recipe.results.map(r => ({
        template_id: r.template_id,
        amount: r.amount * batch_count
      }))
    };
    
  } catch (mintError) {
    // Mint failed - assets are in futuresrelic wallet, can be manually refunded
    updateCraftHistory(craftRecord.id, {
      status: 'failed',
      error_message: mintError.message
    });
    
    throw new Error('Mint failed: ' + mintError.message);
  }
}

