function getResultDisplayName(result, templates) {
  // 1. Use name_override if provided in recipe
  if (result.name_override) return result.name_override;
  
  // 2. Use template name from AtomicAssets
  const template = templates[result.template_id];
  if (template?.name) return template.name;
  
  // 3. Fallback to "Template #123"
  return `Template #${result.template_id}`;
